# Application
APP_NAME="Codenter AI SDR Platform"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql+asyncpg://sdr_admin:sdr_secret_password@localhost:5432/codenter_sdr"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & Encryption (AES-256-GCM envelope encryption)
JWT_SECRET="generate-a-secure-random-jwt-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY_SECRET="base64-32-byte-encryption-key-here"

# Model Gateway API Keys (Optional - Gateway includes fallback simulator if omitted)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# CORS
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
